PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/zahill_pms
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5174
DISPLAY_URL=http://localhost:5175
TV_URL=http://localhost:5176
KITCHEN_URL=http://localhost:5177
RESTO_URL=http://localhost:5178

# Public base URL of the resto-display app — used to build the printable
# per-table QR link (GET /api/resto/tables/:id/qr). Falls back to the first
# RESTO_URL origin if unset.
RESTO_PUBLIC_URL=http://localhost:5178

# This server's own publicly reachable base URL — used to build absolute
# image URLs (property logos) for guest emails, since email clients can't
# resolve relative paths. Leave unset in local dev to skip logo images in
# email (mailer.js degrades gracefully).
SERVER_PUBLIC_URL=

# Room Display / TV Display / Kitchen Display auth — per-property, generated
# at property creation and stored in properties.display_token (migration 021).
# Not an env var; retrieve per-property via GET /api/settings/display-token
# (owner-only) or the Property Details settings page.

# MQTT / IoT
MQTT_BROKER=mqtt://mqtt.d-zahill.kdai.cloud:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=zahill-pms

# TURN relay for room<->staff calling (coturn, self-hosted on the same VM).
# Needed for cross-network calls (e.g. staff off-site, or a MikroTik/NAT
# between the two sides) — STUN alone only works when both sides can reach
# each other directly. Leave unset to keep the existing STUN-only behavior
# (same-network calling only). TURN_SECRET must match coturn's
# `static-auth-secret` in /etc/turnserver.conf. TURN_URLS is comma-separated
# if advertising multiple transports, e.g.:
#   turn:d-zahill.kdai.cloud:3478?transport=udp,turn:d-zahill.kdai.cloud:3478?transport=tcp
TURN_SECRET=
TURN_URLS=

# Market Insights (optional — features degrade gracefully without these)
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=

# Weather (Room Display / TV Display guest board)
OPENWEATHER_API_KEY=

# Indonesian Holidays — api.co.id (docs.api.co.id/products/indonesian-holidays).
# Nightly-synced into the global `holidays` table (see jobs/marketInsights.js
# refreshHolidays) — powers the Market Insights Holidays card and Yield
# Pricing's holiday/event uplift. Gracefully no-ops when unset (holidays stay
# whatever was last seeded/synced). Base URL defaults to https://use.api.co.id
# (undocumented on the static docs page; confirmed via the dashboard's live
# "try it" example) — only override HOLIDAY_API_URL if that changes.
HOLIDAY_API_URL=https://use.api.co.id
HOLIDAY_API_KEY=

# Guest Communication — platform-default SMTP, used when a property hasn't
# configured its own SMTP in Settings (property_settings.smtp_*)
PLATFORM_SMTP_HOST=smtp.gmail.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=your@gmail.com
PLATFORM_SMTP_PASSWORD=your-app-password
PLATFORM_SMTP_FROM=Your Platform <your@gmail.com>

# Telegram — internal staff/owner alerts (new booking, guest requests). One
# shared platform-wide bot (create via @BotFather); staff link their own
# chat to a property in Settings → Communications (paste a chat ID obtained
# from @userinfobot). Alerts silently no-op if unset.
TELEGRAM_BOT_TOKEN=

# Channel Manager — Channex integration (staging sandbox spike, not yet
# production automation — see routes/channelManager.js). One account-level
# API key covers every property in that Channex account (their own auth
# model), same reasoning as GOOGLE_PLACES_API_KEY not being per-property.
# Gracefully no-ops when unset. Get a staging key by signing up at
# https://app.channex.io (staging environment) and generating an API key
# from your profile.
CHANNEX_API_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
