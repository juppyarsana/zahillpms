<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.TVScreensaver"
        android:usesCleartextTraffic="true">

        <!-- On the TV home screen: shows the welcome page now (housekeeping). -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:label="@string/welcome_name"
            android:banner="@drawable/banner"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Room ID / token. No icon of its own: hold OK 3 s on the welcome
             screen, the screensaver's settings in Android, or adb:
             adb shell am start -n com.zahill.tvscreensaver/.MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/settings_name" />

        <service
            android:name=".ZahillDreamService"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_DREAM_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dreams"
                android:resource="@xml/dream" />
        </service>
    </application>
</manifest>
