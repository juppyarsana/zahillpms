<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings for the guest TVs (Sharp AQUOS-TVX19A). -->
<resources>
    <!-- "Watch" row, left to right. Apps that are not installed are skipped. -->
    <string-array name="watch_apps">
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar</item>
        <item>com.vidio.android.tv</item>
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false">com.mediatek.wwtv.tvcenter</string>
</resources>
